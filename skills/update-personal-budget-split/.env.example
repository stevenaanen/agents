# Optional. Path to the bunq SDK context file. Defaults to the sibling /to-pay
# skill's production context, so this skill reuses the same registered device
# and session (no second bunq device registration). Override only if your bunq
# context lives elsewhere.
BUNQ_CONTEXT_PATH=

# This skill reuses /to-pay's virtualenv (which already has bunq_sdk installed).
# Make sure /to-pay is bootstrapped first:
#   cd ../to-pay && python3 to-pay.py bootstrap
