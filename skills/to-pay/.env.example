# bunq personal API key (generate in the bunq Developer portal, then run
#   python3 to-pay.py bootstrap
# to register the key and create the encrypted SDK context.
BUNQ_API_KEY=

# Optional. If your bunq user has more than one monetary account, set the
# numeric ID of the one to draft payments from. Leave blank when there is
# exactly one active account — to-pay.py will auto-detect it.
BUNQ_MONETARY_ACCOUNT_ID=

# Optional. Spark folder identifiers for the source/destination tags. Defaults
# match what `spark folders hi@stevenaanen.com` already shows. Override if your
# Gmail label names differ.
SPARK_TO_PAY_FOLDER=hi@stevenaanen.com:to-pay
SPARK_PAID_FOLDER=hi@stevenaanen.com:paid

# Optional. Use bunq's sandbox environment for testing instead of production.
# Set to "true" to enable. When toggled, run `bootstrap` again to create a
# separate sandbox context next to the production one.
BUNQ_SANDBOX=false
