{
  "mcpServers": {
    "bear": {
      "type": "stdio",
      "command": "/Applications/Bear.app/Contents/MacOS/bearcli",
      "args": [
        "mcp-server"
      ],
      "env": {}
    },
    "things": {
      "command": "uvx",
      "args": [
        "things-mcp"
      ]
    },
    "pocketcasts": {
      "type": "http",
      "url": "https://mcp.pocketcasts.com"
    }
  }
}
